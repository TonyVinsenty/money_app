<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+, тёмная тема: фон заставки = surface тёмной темы приложения -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#121314</item>
        <!-- Только рисунок значка, без светлого фона адаптивной иконки (8.47) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#121314</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
